# Database Configuration
# In production, use an absolute path for SQLite or a connection string for Postgres
DATABASE_URL="file:./dev.db"

# Application URL
# Used for absolute URL generation in PayU and emails
NEXT_PUBLIC_APP_URL="https://donations.example.org"

# Authentication
# Run `openssl rand -base64 32` to generate a strong secret
SESSION_SECRET="YOUR_PRODUCTION_SESSION_SECRET"

# PayU Integration
# Replace with actual PayU credentials provided for production
PAYU_MERCHANT_KEY="YOUR_PAYU_KEY"
PAYU_MERCHANT_SALT="YOUR_PAYU_SALT"
PAYU_ENVIRONMENT="production" # Use 'test' or 'production'

# Secure API Integration
NGO_WEBSITE_ORIGIN="https://www.example.org"
NGO_API_KEY="YOUR_SECURE_SERVER_TO_SERVER_KEY"

# File Storage
UPLOAD_STORAGE_PATH="./storage/uploads/donations"
